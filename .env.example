# =============================================================================
# VARIABLES DE ENTORNO — copia este archivo como .env y rellénalo.
# NUNCA subas el .env al repositorio: sólo este .env.example, que va vacío.
# En Vercel/Netlify se ponen desde el panel del proyecto, no como archivo.
# =============================================================================

# --- Correo (avisos de contacto, citas y reservas de clase) ------------------
# Cuenta gratuita en https://resend.com y dominio verificado.
RESEND_API_KEY=
# A dónde llegan los avisos. Varias direcciones separadas por comas.
CORREO_DESTINO=info@gimnasiosxtreme.es
# Remitente. Tiene que ser de un dominio verificado en el proveedor.
CORREO_ORIGEN=Web Xtreme <web@gimnasiosxtreme.es>

# --- Nota de Google (opcional) -----------------------------------------------
# Sin esto la web enseña la nota del manifiesto y funciona igual.
# Clave con la Places API (New) activada.
GOOGLE_MAPS_API_KEY=
# Identificador de la ficha del negocio en Google Maps.
GOOGLE_PLACE_ID=

# --- Ocupación en vivo (opcional) --------------------------------------------
# URL que devuelva { "xtreme-1": 62, "xtreme-2": 40, "xtreme-3": 51 }
# Sin esto, el gráfico usa el patrón histórico del manifiesto.
OCUPACION_URL=
OCUPACION_TOKEN=
